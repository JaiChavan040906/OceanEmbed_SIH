# Copy to backend/.env and fill in the Groq key.
# Every path below defaults to a bundled file under backend/data_assets/ or
# backend/model_assets/ — you only need to override if you keep an asset
# elsewhere (network drive, big-checkpoint experiment, etc.).

# ─────────────── model checkpoint
# Leave blank to auto-pick from backend/model_assets/ (v3 → v2 fallback).
# CHECKPOINT_PATH=D:/SIh/copernicus/data/checkpoints/oceanembed_v3_best.pt

# ─────────────── bundled data assets (default: backend/data_assets/)
# PREDS_CACHE=backend/data_assets/preds_v3.npz
# STATS_PATH=backend/data_assets/stats.json
# STATIC_PATH=backend/data_assets/static.npy
# SURFACE_TEST_NC=backend/data_assets/surface_2025.nc
# TARGET_TEST_NC=backend/data_assets/target_2025.nc
# CLIMATOLOGY_NC=backend/data_assets/climatology.nc
# ARGO_TEST_PATH=backend/data_assets/argo_test_2025.nc

# ─────────────── region bbox (must match training)
LON_MIN=45.0
LON_MAX=105.0
LAT_MIN=5.0
LAT_MAX=30.0

# ─────────────── Groq API (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ─────────────── server
HOST=0.0.0.0
PORT=8000
